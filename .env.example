HOST=127.0.0.1
PORT=3100
ALLOWED_HOSTS=127.0.0.1,localhost
AI_PROVIDER=mock
EVIDENCE_PROVIDER=bitget
STORAGE_DRIVER=memory
AGENT_AUTH_MODE=open
AGENT_API_KEY_PEPPER=
AGENT_REGISTRATION_TOKEN=

# Claude live mode: set AI_PROVIDER=claude.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5
CLAUDE_TIMEOUT_MS=60000
CLAUDE_MAX_RETRIES=2

# Qwen live mode: set AI_PROVIDER=qwen and provide matching regional credentials.
QWEN_API_KEY=
QWEN_BASE_URL=
QWEN_MODEL=qwen-plus
QWEN_TIMEOUT_MS=45000
QWEN_MAX_RETRIES=2

# Bitget public market evidence needs no API credentials.
# Use STORAGE_DRIVER=postgres in deployed environments.
DATABASE_URL=
DATABASE_SSL=false
